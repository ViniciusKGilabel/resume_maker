# Tudo opcional. As configurações de LLM e busca também podem ser feitas pela página (⚙ Configurações).
# O .env só é lido na primeira execução, para criar o provider inicial. Depois vale o que está salvo no banco.

# Porta publicada no host
PORT=3000

# Provider inicial de LLM
# LLM_KIND: openai-compatible (OpenRouter, Groq, Gemini, DeepSeek, Ollama) ou anthropic
LLM_KIND=openai-compatible
LLM_NAME=Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Busca na web (sem chave usa DuckDuckGo)
TAVILY_API_KEY=
BRAVE_API_KEY=
